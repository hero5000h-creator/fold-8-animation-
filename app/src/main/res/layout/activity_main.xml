<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0C0E">

    <!-- Left half of the "screen content" -->
    <View
        android:id="@+id/panelLeft"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="#111318" />

    <!-- Right half of the "screen content" -->
    <View
        android:id="@+id/panelRight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="#15171d" />

    <!-- Thin line marking the hinge, fades as the phone opens flat -->
    <View
        android:id="@+id/hingeLine"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="#3A3D43" />

    <TextView
        android:id="@+id/angleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:textColor="#6C7178"
        android:textSize="14sp"
        android:text="hinge: -- °" />

</FrameLayout>
